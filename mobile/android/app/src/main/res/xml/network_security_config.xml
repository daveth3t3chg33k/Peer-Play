<?xml version="1.0" encoding="utf-8"?>
<!--
  The torrent engine streams video over plain HTTP on the loopback interface
  (http://127.0.0.1:<proxy port>/stream/<id>), and the dev backend is served
  over plain HTTP on 10.0.2.2. ExoPlayer uses the platform network stack, which
  blocks cleartext traffic by default for targetSdk >= 28, so those hosts must
  be explicitly allowed.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
